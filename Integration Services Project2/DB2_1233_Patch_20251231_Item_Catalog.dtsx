      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0BC696F0-EC0B-4459-B510-122B6C034F5D}"
          SQLTask:SqlStatementSource="UPDATE &quot;MIGRATION&quot;.&quot;PATCH_20251231_ITEM_CATALOG&quot;&#xA;SET &#xA;&#x9;ATTACHMENT=1&#xA;WHERE 1=1&#xA;&#x9;AND ID IN (&#xA;&#x9;&#x9;SELECT ID&#xA;&#x9;&#x9;FROM (&#xA;&#x9;&#x9;&#x9;SELECT ID, ROW_NUMBER() OVER (PARTITION BY ITEMID ORDER BY IMAGENAME) RN&#xA;&#x9;&#x9;&#x9;FROM &quot;MIGRATION&quot;.&quot;PATCH_20251231_ITEM_CATALOG&quot;&#xA;&#x9;&#x9;&#x9;WHERE COALESCE(ITEMID,0)!=0&#xA;&#x9;&#x9;) A&#xA;&#x9;&#x9;WHERE A.RN&gt;1&#xA;&#x9;)&#xA;;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\UPDATE ITEMID"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0E568FCF-0474-4062-96E1-28BBEF6AF9D0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="UPDATE ITEMID"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0BC696F0-EC0B-4459-B510-122B6C034F5D}"
          SQLTask:SqlStatementSource="MERGE INTO &quot;MIGRATION&quot;.&quot;PATCH_20251231_ITEM_CATALOG&quot; A&#xA;USING (&#xA;&#x9;SELECT A.ID, A.STE_CSWNITEMNO, B.ITEMID,&#xA;&#x9;&#x9;ROW_NUMBER() OVER (PARTITION BY A.ID ORDER BY (CASE WHEN B.STATUS='ACTIVE' THEN 0 ELSE 1 END)) AS RN&#xA;&#x9;FROM &quot;MIGRATION&quot;.&quot;PATCH_20251231_ITEM_CATALOG&quot; A&#xA;&#x9;JOIN MAXIMO.ITEM B ON B.STE_CSWNITEMNO=A.STE_CSWNITEMNO&#xA;&#x9;WHERE COALESCE(A.ITEMID,0)=0&#xA;) B ON B.ID=A.ID AND B.RN=1&#xA;WHEN MATCHED THEN&#xA;UPDATE SET&#xA;&#x9;A.ITEMID=B.ITEMID&#xA;;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
