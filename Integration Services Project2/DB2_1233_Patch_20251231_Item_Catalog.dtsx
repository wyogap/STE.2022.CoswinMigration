          SQLTask:SqlStatementSource="MERGE INTO &quot;MIGRATION&quot;.&quot;PATCH_20251231_ITEM_CATALOG&quot; A&#xA;USING (&#xA;&#x9;SELECT A.ID, A.STE_CSWNITEMNO, B.ITEMID, C.STE_CSWNITEMNO AS NEW_CSWNITEMNO&#xA;&#x9;FROM &quot;MIGRATION&quot;.&quot;PATCH_20251231_ITEM_CATALOG&quot; A&#xA;&#x9;JOIN MIGRATION.PATCH_20250808_ITEM_CATALOG B ON B.PATH=A.PATH&#xA;&#x9;JOIN MAXIMO.ITEM C ON C.ITEMID=B.ITEMID&#xA;&#x9;WHERE COALESCE(A.ITEMID,0)=0 AND COALESCE(B.ITEMID,0)!=0&#xA;) B ON B.ID=A.ID&#xA;WHEN MATCHED THEN&#xA;UPDATE SET&#xA;&#x9;A.ITEMID=B.ITEMID,&#xA;&#x9;A.STE_CSWNITEMNO=B.NEW_CSWNITEMNO&#xA;;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
