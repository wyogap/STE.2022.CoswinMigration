          SQLTask:SqlStatementSource="MERGE INTO MIGRATION.PATCH_20251231_ITEM_CATALOG A&#xA;USING (&#xA;&#x9; SELECT A.ID, A.STE_CSWNITEMNO, A.ITEMID, A.ISNEW, A.ATTACHMENT, B.STE_CSWNITEMNO AS NEW_CSWNITEMNO, B.ITEMID AS NEW_ITEMID&#xA;&#x9; FROM MIGRATION.PATCH_20251231_ITEM_CATALOG A&#xA;&#x9; JOIN MAXIMO.ITEM B ON B.STE_CSWNITEMNO=REPLACE(A.STE_CSWNITEMNO, '/', '-')&#xA;&#x9; WHERE A.itemid IS NULL&#xA;&#x9;  AND A.ste_cswnitemno LIKE 'LRT%'&#xA;) B ON B.ID=A.ID&#xA;WHEN MATCHED THEN&#xA;UPDATE SET&#xA; A.STE_CSWNITEMNO=B.NEW_CSWNITEMNO,&#xA; A.ITEMID=B.NEW_ITEMID&#xA;;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
