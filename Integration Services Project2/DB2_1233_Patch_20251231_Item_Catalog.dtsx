      DTS:ObjectName="CHECK ISNEW"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0BC696F0-EC0B-4459-B510-122B6C034F5D}"
          SQLTask:SqlStatementSource="UPDATE &quot;MIGRATION&quot;.&quot;PATCH_20251231_ITEM_CATALOG&quot;&#xA;SET &#xA;&#x9;ISNEW=1&#xA;WHERE 1=1&#xA;&#x9;AND ID IN (&#xA;&#x9;&#x9;SELECT A.ID&#xA;&#x9;&#x9;FROM &quot;MIGRATION&quot;.&quot;PATCH_20251231_ITEM_CATALOG&quot; A&#xA;&#x9;&#x9;LEFT JOIN MIGRATION.PATCH_20250808_ITEM_CATALOG B ON B.PATH=A.PATH&#xA;&#x9;&#x9;WHERE B.ID IS NULL&#xA;&#x9;)&#xA;;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CLEAN UP"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FBF3ED96-DACB-40E1-9822-FC1829B0C0A6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CLEAN UP"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0BC696F0-EC0B-4459-B510-122B6C034F5D}"
          SQLTask:SqlStatementSource="UPDATE &quot;MIGRATION&quot;.&quot;PATCH_20251231_ITEM_CATALOG&quot;&#xA;SET&#xA;&#x9;&quot;PATH&quot; = TRIM(&quot;PATH&quot;), &#xA;&#x9;&quot;STE_CSWNITEMNO&quot; = TRIM(&quot;STE_CSWNITEMNO&quot;),&#xA;&#x9;&quot;MIMETYPE&quot; = CASE WHEN FILETYPE='GIF' THEN 'image/gif'&#xA;&#x9;&#x9;&#x9;WHEN FILETYPE='BMP' THEN 'image/bmp'&#xA;&#x9;&#x9;&#x9;WHEN FILETYPE='PNG' THEN 'image/png'&#xA;&#x9;&#x9;&#x9;WHEN FILETYPE IN ('JPG', 'JPEG') THEN 'image/jpeg'&#xA;&#x9;&#x9;&#x9;ELSE NULL&#xA;&#x9;&#x9;END&#xA;;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CREATE TABLE (IF NOT EXIST)"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{044c671b-7417-402d-8730-8d770fb99b0d}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CREATE TABLE (IF NOT EXIST)"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0BC696F0-EC0B-4459-B510-122B6C034F5D}"
          SQLTask:SqlStatementSource="CREATE TABLE IF NOT EXISTS &quot;MIGRATION&quot;.&quot;PATCH_20251231_ITEM_CATALOG&quot;  (&#xA;  &quot;ID&quot; BIGINT NOT NULL GENERATED BY DEFAULT AS IDENTITY (  &#xA;    START WITH +1  &#xA;    INCREMENT BY +1  &#xA;    MINVALUE +1  &#xA;    MAXVALUE +9223372036854775807  &#xA;    NO CYCLE  &#xA;    CACHE 20  &#xA;    NO ORDER ) , &#xA;  &quot;PATH&quot; VARCHAR(500 OCTETS) NOT NULL , &#xA;  &quot;FILETYPE&quot; VARCHAR(12 OCTETS) , &#xA;  &quot;STE_CSWNITEMNO&quot; VARCHAR(50 OCTETS) NOT NULL , &#xA;  &quot;ITEMID&quot; BIGINT , &#xA;  &quot;ATTACHMENT&quot; SMALLINT NOT NULL WITH DEFAULT 1 , &#xA;  &quot;IMAGENAME&quot; VARCHAR(100 OCTETS) NOT NULL , &#xA;  &quot;IMAGE&quot; BLOB(1073741824) LOGGED NOT COMPACT , &#xA;  &quot;MIMETYPE&quot; VARCHAR(50 OCTETS) NOT NULL , &#xA;  &quot;FILENAME&quot; VARCHAR(100 OCTETS) , &#xA;  &quot;FILESIZE&quot; BIGINT , &#xA;  &quot;ISNEW&quot; SMALLINT DEFAULT 0,&#xA;  &quot;DUPLICATE&quot; SMALLINT DEFAULT 0,&#xA;  &quot;RN&quot; INTEGER )   &#xA; IN &quot;MAXDATA&quot;  &#xA; ORGANIZE BY ROW;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
