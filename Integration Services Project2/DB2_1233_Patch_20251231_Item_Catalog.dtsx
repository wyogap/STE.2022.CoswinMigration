      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0BC696F0-EC0B-4459-B510-122B6C034F5D}"
          SQLTask:SqlStatementSource="MERGE INTO MIGRATION.PATCH_20251231_ITEM_CATALOG A&#xA;USING (&#xA;&#x9;SELECT A.ID, A.STE_CSWNITEMNO, A.ITEMID, B.STE_CSWNITEMNO AS NEW_CSWNITEMNO, B.ITEMID AS NEW_ITEMID, A.ISNEW&#xA;&#x9;FROM MIGRATION.PATCH_20251231_ITEM_CATALOG A&#xA;&#x9;JOIN MAXIMO.ITEM B ON B.STE_CSWNITEMNO=SUBSTR(REPLACE(A.STE_CSWNITEMNO, '/', '-'),1,LENGTH(A.STE_CSWNITEMNO)-1)&#xA;&#x9;WHERE A.ITEMID IS NULL&#xA;) B ON B.ID=A.ID&#xA;WHEN MATCHED THEN&#xA;UPDATE SET&#xA; &#x9;--A.STE_CSWNITEMNO=B.NEW_CSWNITEMNO,&#xA; &#x9;A.ITEMID=B.NEW_ITEMID,&#xA; &#x9;A.ISNEW=1&#xA;;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
