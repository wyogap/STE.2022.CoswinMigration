      DTS:ObjectName="CHECK DUPLICATE"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0BC696F0-EC0B-4459-B510-122B6C034F5D}"
          SQLTask:SqlStatementSource="UPDATE &quot;MIGRATION&quot;.&quot;PATCH_20251231_ITEM_CATALOG&quot;&#xA;SET &#xA;&#x9;DUPLICATE=1&#xA;WHERE 1=1&#xA;&#x9;AND ID IN (&#xA;&#x9;&#x9;SELECT ID&#xA;&#x9;&#x9;FROM (&#xA;&#x9;&#x9;&#x9;SELECT ID, ROW_NUMBER() OVER (PARTITION BY ITEMID, FILESIZE ORDER BY IMAGENAME) RN&#xA;&#x9;&#x9;&#x9;FROM &quot;MIGRATION&quot;.&quot;PATCH_20251231_ITEM_CATALOG&quot;&#xA;&#x9;&#x9;&#x9;WHERE COALESCE(ITEMID,0)!=0&#xA;&#x9;&#x9;) A&#xA;&#x9;&#x9;WHERE A.RN&gt;1&#xA;&#x9;)&#xA;;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CHECK ISNEW"
